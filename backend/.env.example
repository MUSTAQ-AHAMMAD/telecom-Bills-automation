# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Global settings ----
# Where organized invoices are stored, relative to backend/ or an absolute path
DOWNLOAD_ROOT=./data/Root
# Run the browser headless (true) or visible for debugging (false)
HEADLESS=true
# Max seconds to wait for the user to enter the OTP before the job fails
OTP_TIMEOUT_SECONDS=180
# Path to the "TELECOMMUNICATION MASTER" spreadsheet — one sheet per
# entity+carrier (e.g. "STC IBQ", "Mobily MATCH"), mapping account numbers
# to real-world Location/Branch. Used by POST /api/master/import to build
# data/master.db, which powers location-wise stats and the Invoice
# Archive's Location column.
MASTER_EXCEL_PATH=C:\path\to\TELECOMMUNICATION MASTER.xlsx

# ---- Per-carrier portal config (shared by every entity's login against that carrier) ----
# Each carrier (STC / Mobily / Zain) has its own portal URL and CSS
# selectors, since each portal's markup differs — but that config is the
# SAME regardless of which entity (Ibraq/Match/Salfa/Feelin) is logging in,
# since it's still the same portal. Inspect each real portal with browser
# devtools and update the selectors below — the values shipped here are
# placeholders and will not match a live site.

# STC
# Login, accounts-list, and download-menu selectors below were all confirmed
# against the real portal. STC's accounts page is a div-based infinite-scroll
# list, not a <table> — see `_scrape_stc_row` in app/automation.py. Clicking
# an account row opens a bill-detail modal with a "Download bill" button
# that opens a dropdown menu (View bill PDF summary / View bill PDF details /
# View Tax invoice / Multiple bills download) — we click whichever item's
# text matches STC_SELECTOR_INVOICE_MENU_ITEM_TEXT (case-insensitive
# substring; "invoice" matches "View Tax invoice" uniquely).
# OTP selectors are still placeholders (only appear mid-login, see README).
STC_PORTAL_URL=https://business.stc.com.sa/content/cxp-wp/sa/en/home/login.html
STC_SELECTOR_USERNAME_INPUT=input[type="text"]
STC_SELECTOR_PASSWORD_INPUT=input[type="password"]
STC_SELECTOR_LOGIN_BUTTON=button:has-text("Login")
STC_SELECTOR_OTP_INPUT=#otp
STC_SELECTOR_OTP_SUBMIT_BUTTON=#otp-submit

# After login, STC lands on a Home/dashboard page, not the billing accounts
# list — these two clicks (sidebar "Billing" section, then its "Accounts"
# submenu item) navigate there before the accounts list is scraped.
# If a promo/ad modal appears right after login, set its close button here
# (best-effort — a job never fails just because this isn't found).
STC_SELECTOR_POST_LOGIN_DISMISS_BUTTON=button:has-text("Skip")
STC_SELECTOR_NAV_MENU_ITEM=#billing .item-container
STC_SELECTOR_NAV_SUBMENU_ITEM=#billing >> text="Accounts"

STC_SELECTOR_ACCOUNTS_TABLE_ROW=.billing-account-list-item-container__item
# The accounts list only renders ~10 rows at a time inside this scrollable
# container, loading more as it scrolls — without this set, any accounts
# beyond the first batch are silently missed.
STC_SELECTOR_SCROLL_CONTAINER=#billing-account-scroll-container
STC_SELECTOR_INVOICE_DOWNLOAD_BUTTON=.billing-shared-context-menu-toggle-button
STC_SELECTOR_INVOICE_MENU_ITEM_TEXT=PDF details
# Clicking the menu item above opens an in-page PDF preview with its own
# "Download PDF" button — confirmed against the real portal.
STC_SELECTOR_INVOICE_DOWNLOAD_CONFIRM_BUTTON=.billing-preview-pdf-screen-download-btn

# Month-cycle pagination: the bill-detail modal has "Previous bill"/"Next
# bill" arrow buttons and a "Selected bill: <Month, Year>" label. Set
# STC_MONTHS_TO_FETCH > 1 to also download that many previous months'
# invoices per account (each into its own real Month_Year folder); leave at
# 1 to only fetch the current/latest bill (no pagination attempted).
STC_SELECTOR_PREV_MONTH_BUTTON=button[aria-label="Previous bill"]
STC_SELECTOR_MONTH_LABEL=.billing-bill-cycle-selector-label-date
STC_MONTHS_TO_FETCH=3

# Mobily
MOBILY_PORTAL_URL=https://business.mobily.com.sa/login
MOBILY_SELECTOR_USERNAME_INPUT=#username
MOBILY_SELECTOR_PASSWORD_INPUT=#password
MOBILY_SELECTOR_LOGIN_BUTTON=button[type="submit"]
MOBILY_SELECTOR_OTP_INPUT=#otp
MOBILY_SELECTOR_OTP_SUBMIT_BUTTON=#otp-submit
MOBILY_SELECTOR_ACCOUNTS_TABLE_ROW=table.accounts tbody tr
MOBILY_SELECTOR_INVOICE_DOWNLOAD_BUTTON=a.download-invoice

# Zain
ZAIN_PORTAL_URL=https://business.zain.sa/login
ZAIN_SELECTOR_USERNAME_INPUT=#username
ZAIN_SELECTOR_PASSWORD_INPUT=#password
ZAIN_SELECTOR_LOGIN_BUTTON=button[type="submit"]
ZAIN_SELECTOR_OTP_INPUT=#otp
ZAIN_SELECTOR_OTP_SUBMIT_BUTTON=#otp-submit
ZAIN_SELECTOR_ACCOUNTS_TABLE_ROW=table.accounts tbody tr
ZAIN_SELECTOR_INVOICE_DOWNLOAD_BUTTON=a.download-invoice

# ---- Per-entity, per-carrier logins ----
# Each of the 4 entities (Ibraq / Match / Salfa / Feelin) has its own
# independent logins against every carrier — e.g. Ibraq's own STC account(s),
# Match's own STC account(s), Salfa's own Mobily account(s), etc. Naming:
# <ENTITY>_<CARRIER>_ACCOUNT_<N>_LABEL / _USERNAME / _PASSWORD. An
# entity+carrier pair can have more than one real-world account — e.g.
# three separate STC business logins for the same entity — each getting
# its own numbered slot (_ACCOUNT_1_, _ACCOUNT_2_, ...). The backend
# auto-discovers however many slots have a username set, and the dashboard
# shows one tab per slot, each independently refreshable. Leave a slot's
# username blank to skip it. LABEL is optional — it's just what shows on
# the tab.

# ---- Ibraq ----
# STC — 3 accounts
IBRAQ_STC_ACCOUNT_1_LABEL=Account 1
IBRAQ_STC_ACCOUNT_1_USERNAME=your_ibraq_stc_account1_username
IBRAQ_STC_ACCOUNT_1_PASSWORD=your_ibraq_stc_account1_password

IBRAQ_STC_ACCOUNT_2_LABEL=Account 2
IBRAQ_STC_ACCOUNT_2_USERNAME=your_ibraq_stc_account2_username
IBRAQ_STC_ACCOUNT_2_PASSWORD=your_ibraq_stc_account2_password

IBRAQ_STC_ACCOUNT_3_LABEL=Account 3
IBRAQ_STC_ACCOUNT_3_USERNAME=your_ibraq_stc_account3_username
IBRAQ_STC_ACCOUNT_3_PASSWORD=your_ibraq_stc_account3_password

# Mobily — 1 account
IBRAQ_MOBILY_ACCOUNT_1_LABEL=Account 1
IBRAQ_MOBILY_ACCOUNT_1_USERNAME=your_ibraq_mobily_username
IBRAQ_MOBILY_ACCOUNT_1_PASSWORD=your_ibraq_mobily_password

# Zain — 1 account
IBRAQ_ZAIN_ACCOUNT_1_LABEL=Account 1
IBRAQ_ZAIN_ACCOUNT_1_USERNAME=your_ibraq_zain_username
IBRAQ_ZAIN_ACCOUNT_1_PASSWORD=your_ibraq_zain_password

# ---- Match ----
MATCH_STC_ACCOUNT_1_LABEL=Account 1
MATCH_STC_ACCOUNT_1_USERNAME=your_match_stc_username
MATCH_STC_ACCOUNT_1_PASSWORD=your_match_stc_password

MATCH_MOBILY_ACCOUNT_1_LABEL=Account 1
MATCH_MOBILY_ACCOUNT_1_USERNAME=your_match_mobily_username
MATCH_MOBILY_ACCOUNT_1_PASSWORD=your_match_mobily_password

MATCH_ZAIN_ACCOUNT_1_LABEL=Account 1
MATCH_ZAIN_ACCOUNT_1_USERNAME=your_match_zain_username
MATCH_ZAIN_ACCOUNT_1_PASSWORD=your_match_zain_password

# ---- Salfa ----
SALFA_STC_ACCOUNT_1_LABEL=Account 1
SALFA_STC_ACCOUNT_1_USERNAME=your_salfa_stc_username
SALFA_STC_ACCOUNT_1_PASSWORD=your_salfa_stc_password

SALFA_MOBILY_ACCOUNT_1_LABEL=Account 1
SALFA_MOBILY_ACCOUNT_1_USERNAME=your_salfa_mobily_username
SALFA_MOBILY_ACCOUNT_1_PASSWORD=your_salfa_mobily_password

SALFA_ZAIN_ACCOUNT_1_LABEL=Account 1
SALFA_ZAIN_ACCOUNT_1_USERNAME=your_salfa_zain_username
SALFA_ZAIN_ACCOUNT_1_PASSWORD=your_salfa_zain_password

# ---- Feelin ----
FEELIN_STC_ACCOUNT_1_LABEL=Account 1
FEELIN_STC_ACCOUNT_1_USERNAME=your_feelin_stc_username
FEELIN_STC_ACCOUNT_1_PASSWORD=your_feelin_stc_password

FEELIN_MOBILY_ACCOUNT_1_LABEL=Account 1
FEELIN_MOBILY_ACCOUNT_1_USERNAME=your_feelin_mobily_username
FEELIN_MOBILY_ACCOUNT_1_PASSWORD=your_feelin_mobily_password

FEELIN_ZAIN_ACCOUNT_1_LABEL=Account 1
FEELIN_ZAIN_ACCOUNT_1_USERNAME=your_feelin_zain_username
FEELIN_ZAIN_ACCOUNT_1_PASSWORD=your_feelin_zain_password
